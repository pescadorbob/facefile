{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  // `unit/` imports the backend's pure modules from ../amplify, which sits outside this
  // rootDir. Those specs are governed by tsconfig.jest.json (rootDir "..") instead.
  "exclude": ["dist", "node_modules", "unit"]
}
